<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | KIM Bumantara</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen font-sans">

    <header class="bg-blue-900 text-white shadow-lg border-b-4 border-yellow-500 relative z-50" x-data="{ mobileMenuOpen: false }">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            
            <a href="/" class="flex items-center space-x-3 group relative">
    <div class="w-18 h-16 bg-white rounded-full flex items-center justify-center shadow-md border-2 border-[#ea8e24] overflow-hidden transition transform group-hover:scale-105 duration-200">
        <img src="/assets/img/logo-kim-bumantara.jpeg" alt="Logo KIM Bumantara" class="w-full h-full object-cover scale-80">
    </div>
    <div class="leading-none">
        <h1 class="text-xl md:text-2xl font-black tracking-wide text-white group-hover:text-yellow-400 transition">KIM BUMANTARA</h1>
        <p class="text-[11px] text-teal-300 tracking-tight uppercase font-bold mt-1">Kalurahan Depok, Panjatan</p>
    </div>
</a>

            <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden text-white hover:text-yellow-400 focus:outline-none transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <nav class="hidden md:flex space-x-2 items-center">
                {% for menu in navigation %}
                    {% if menu.submenu %}
                        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
                            <button class="px-3 py-2 rounded-md text-sm font-semibold tracking-wide hover:bg-blue-800 hover:text-yellow-400 inline-flex items-center space-x-1 focus:outline-none transition">
                                <span>{{ menu.name }}</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200" :class="{'rotate-180': open}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div x-show="open" 
                                 x-transition:enter="transition ease-out duration-150"
                                 x-transition:enter-start="transform opacity-0 scale-95"
                                 x-transition:enter-end="transform opacity-100 scale-100"
                                 class="absolute left-0 w-56 bg-white text-slate-800 rounded-md shadow-xl py-2 mt-0 border-t-2 border-yellow-500">
                                {% for sub in menu.submenu %}
                                    <a href="{{ sub.url }}" class="block px-4 py-2 text-sm font-medium hover:bg-blue-50 hover:text-blue-900 border-l-2 border-transparent hover:border-yellow-500 transition">{{ sub.name }}</a>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ menu.url }}" class="px-3 py-2 rounded-md text-sm font-semibold tracking-wide hover:bg-blue-800 hover:text-yellow-400 transition">{{ menu.name }}</a>
                    {% endif %}
                {% endfor %}
            </nav>
        </div>

        <div x-show="mobileMenuOpen" class="md:hidden bg-blue-950 px-4 pt-2 pb-4 space-y-1 shadow-inner border-t border-blue-800" x-cloak>
            {% for menu in navigation %}
                {% if menu.submenu %}
                    <div x-data="{ subOpen: false }">
                        <button @click="subOpen = !subOpen" class="w-full text-left block px-3 py-2 rounded-md text-base font-semibold hover:bg-blue-900 hover:text-yellow-400 flex justify-between items-center transition">
                            <span>{{ menu.name }}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform duration-200" :class="{ 'rotate-180': subOpen }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <div x-show="subOpen" class="pl-4 bg-blue-900/30 rounded-md mt-1 space-y-1 py-1 border-l-2 border-yellow-500">
                            {% for sub in menu.submenu %}
                                <a href="{{ sub.url }}" class="block px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:bg-blue-900 hover:text-white">{{ sub.name }}</a>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <a href="{{ menu.url }}" class="block px-3 py-2 rounded-md text-base font-semibold hover:bg-blue-900 hover:text-yellow-400 transition">{{ menu.name }}</a>
                {% endif %}
            {% endfor %}
        </div>
    </header>

    <main class="container mx-auto px-4 py-8 flex-grow">
        {{ content | safe }}
    </main>

    <footer class="bg-slate-900 text-slate-400 text-center py-6 mt-auto border-t-4 border-blue-900">
        <div class="container mx-auto px-4">
            <p class="text-sm font-semibold text-slate-300">Kelompok Informasi Masyarakat (KIM) Bumantara</p>
            <p class="text-xs text-slate-500 mt-1">Kalurahan Depok, Kapanewon Panjatan, Kabupaten Kulon Progo, DI Yogyakarta</p>
            <div class="w-16 h-1 bg-yellow-500 mx-auto my-3 rounded-full"></div>
            <p class="text-[11px] text-slate-600">&copy; 2026 KIM Bumantara. Semua Hak Cipta Dilindungi.</p>
        </div>
    </footer>

</body>
</html>